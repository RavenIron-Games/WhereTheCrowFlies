<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Deterministic, cross‑platform, BepInEx‑friendly -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <!-- Keep the build machine's folders out of the shipped DLL. Without
         this the PE debug directory carries the absolute PDB path
         (C:\Users\<name>\...\obj\Release\WhereTheCrowFlies.pdb), which exposes
         the Windows user name and makes the md5 depend on where the repo
         is checked out. The SDK maps each source root to /_/, /_1/, … in
         the DLL, the PDB and the PDB's Source Link table alike. -->
    <DeterministicSourcePaths>true</DeterministicSourcePaths>

    <!-- Output single DLL directly to bin/ -->
    <AssemblyName>WhereTheCrowFlies</AssemblyName>
    <OutputPath>bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- Always name the project folder as a source root for the mapping
         above. In a git checkout git adds the same root with its Source
         Link data and the two merge into one; without it (a source zip, a
         broken .git, git queries switched off) the folder would stay
         unmapped and its absolute path would go back into the DLL with no
         warning. This csproj sits at the repo root; a project in a
         subfolder should add the repo root instead (e.g. from a
         Directory.Build.props there). -->
    <SourceRoot Include="$(MSBuildThisFileDirectory)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Publicizes assembly_valheim so protected fields like Character.m_lastHit resolve cleanly -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx + Harmony -->
    <Reference Include="BepInEx">
      <HintPath>..\libs-Tools\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\libs-Tools\0Harmony.dll</HintPath>
    </Reference>

    <!-- Valheim assemblies -->
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>..\libs-Tools\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>..\libs-Tools\assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>..\libs-Tools\assembly_guiutils.dll</HintPath>
    </Reference>

    <!-- UnityEngine modular assemblies -->
    <Reference Include="UnityEngine">
      <HintPath>..\libs-Tools\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\libs-Tools\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\libs-Tools\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <!-- The title panel's IMGUI window and the vendored GiltFrameTheme (Libs/SharedUI) -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\libs-Tools\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\libs-Tools\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
